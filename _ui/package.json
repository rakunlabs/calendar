{
  "name": "@rakunlabs/calendar-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src",
    "test:browser": "node tests/browser.mjs",
    "test:basepath": "node tests/basepath.browser.mjs",
    "test:ui": "node tests/calendar.browser.mjs && node tests/editor.browser.mjs && node tests/theme.browser.mjs && node tests/tools.browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@lucide/svelte": "^1.41.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/svelte": "^5.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
